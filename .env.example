# Copy to `.env` at the repo root. Gitignored; the server loads it at startup and
# real environment variables always win, so this is local convenience only —
# Render sets its own.

# ── Where the deck comes from ────────────────────────────────────────────────
# Precedence: QUESTIONS_FILE > QUESTIONS_SHEET_URL > questions/questions.json

# A local JSON bank. Path relative to the repo root, or absolute.
# This is the testing hatch: play a whole game without learning a real answer.
# `npm run dev:mock` sets exactly this, so you only need it here if you want the
# mock deck to be the default for every `npm run dev`.
#QUESTIONS_FILE=questions/questions.mock.json

# The real bank: a Google Sheet, File → Share → Publish to web → CSV.
# Columns, in order: question | answer | unit | category | funFact
#QUESTIONS_SHEET_URL=https://docs.google.com/spreadsheets/d/e/…/pub?gid=0&single=true&output=csv

# ── Server ───────────────────────────────────────────────────────────────────
#PORT=3001
